<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!--
        El parent POM de Spring Boot hace mucho trabajo por nosotros:
        - Gestiona las versiones de TODAS las dependencias comunes (no necesitamos
          especificar versión para spring-boot-starter-* ni para Testcontainers)
        - Configura el compilador para UTF-8
        - Configura los plugins de Maven para tests (Surefire, Failsafe)
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.0</version>
        <relativePath/>
    </parent>

    <groupId>com.listenglish</groupId>
    <artifactId>listenglish</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>ListenGlish</name>
    <description>Busca palabras en inglés en subtítulos de vídeos reales</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>

        <!-- REST + Tomcat embebido + Jackson (serialización JSON) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Hibernate (JPA) + Spring Data JPA (repositories) + gestión de transacciones -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Flyway core: ejecuta migraciones SQL en orden (V1, V2, V3...) -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <!--
            Desde Flyway 10, el soporte para PostgreSQL está en un artefacto separado.
            Olvidarlo causa: "FlywayException: Unable to autodetect JDBC driver"
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!--
            Driver JDBC de PostgreSQL.
            scope=runtime: solo se necesita en ejecución, no en compilación.
            JPA/Hibernate lo usa internamente para enviar SQL a la base de datos.
        -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            JUnit 5 + Mockito + AssertJ + Spring Test (MockMvc, @SpringBootTest...).
            scope=test: estos JARs nunca llegan al JAR de producción.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            Testcontainers: arranca contenedores Docker reales durante los tests.
            Así los tests de integración usan PostgreSQL real, no un simulador (H2).
            spring-boot-testcontainers: integración automática con Spring Boot 3.1+
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!--
                Añade `mvn spring-boot:run` y empaqueta un "fat JAR" (uber-JAR):
                un único JAR ejecutable que contiene todas las dependencias.
                Se despliega con: java -jar target/listenglish-0.0.1-SNAPSHOT.jar
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
                Surefire ejecuta los tests unitarios (mvn test).
                En Java 21+ el sistema de módulos es mas estricto: Mockito necesita
                acceso reflectivo a java.lang para generar subclases en memoria.
                La flag add-opens lo habilita sin cambiar el codigo de tests.
                EnableDynamicAgentLoading: suprime el warning de ByteBuddy.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>
                        --add-opens java.base/java.lang=ALL-UNNAMED
                        -XX:+EnableDynamicAgentLoading
                    </argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
